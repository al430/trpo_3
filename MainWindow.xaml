<Window x:Class="trpo_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:trpo_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800"
        Background = "#f2f6f9">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#376b66" Padding="10">
            <TextBlock Text="Бронирование номера" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Забронировать" Width="130" Height="30" Margin="0,0,10,0"/>
            <Button Content="Отмена" Width="80" Height="30"/>
        </StackPanel>

        <Border Background = "White" Margin="10,10,10,0" BorderThickness="1">
        <StackPanel Margin="15" >

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" Padding="10" Margin="5" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Гость" FontSize="14" Margin="10"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО" VerticalAlignment="Center" Margin="5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="5"></TextBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="5"></TextBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Электронная почта" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="5"></TextBox>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Количество гостей" VerticalAlignment="Center" Margin="5"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="5" SelectedIndex="0">
                                <ComboBoxItem Content="1"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" Padding="10" Margin="5" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Проживание" FontSize="14" Margin="10"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата заезда" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" Margin="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата выезда" VerticalAlignment="Center" Margin="5"/>
                            <DatePicker Grid.Row="1" Grid.Column="1" Margin="5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Категория номера" VerticalAlignment="Center" Margin="5"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="5" SelectedIndex="0">
                                <ComboBoxItem Content="Стандарт"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Способ оплаты" VerticalAlignment="Center" Margin="5"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="5" SelectedIndex="0">
                                <ComboBoxItem Content="Банковская карта"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>


            </Grid>

            <WrapPanel Margin="10" Orientation="Vertical" Height="100">
                <CheckBox Content="Завтрак" Margin="0,0,15,5"/>
                <CheckBox Content="Парковка" Margin="0,0,15,5"/>
                <CheckBox Content="Трансфер" Margin="0,0,15,5"/>
                <CheckBox Content="Поздний выезд" Margin="0,0,15,5"/>
                <CheckBox Content="Детская кроватка" Margin="0,0,15,5"/>
                <CheckBox Content="Размещение с животным" Margin="0,0,15,5"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="Ночей: 3" Margin="0,0,15,0"/>
                <TextBlock Text="Стоимость номера: 4 000 ₽/сутки" Margin="0,0,15,0"/>
                <TextBlock Text="Итого: 12 000 ₽" FontWeight="Bold"/>
            </StackPanel>
            
        </StackPanel>
        </Border>
    </DockPanel>
</Window>
